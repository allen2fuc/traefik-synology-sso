# Synology SSO 配置
SYNOLOGY_BASE_URL=https://your-nas.example.com:5001
# 对应 Synology 界面「应用程序 ID」
SYNOLOGY_CLIENT_ID=your_application_id
# 对应 Synology 界面「应用程序密钥」（界面无此项时留空）
SYNOLOGY_CLIENT_SECRET=your_application_secret

# 应用配置
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# 是否跳过 SSL 验证（NAS 自签名证书时设为 true）
SSL_VERIFY=false
